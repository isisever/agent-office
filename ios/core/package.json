{
  "private": true,
  "name": "agent-office-remote-core",
  "version": "0.0.1",
  "description": "Bare worklet of Agent Office Remote: the P2P link stack, shared with the desktop app",
  "main": "worklet.js",
  "scripts": {
    "link": "bare-link --preset ios --out ../AgentOfficeRemote/addons . && node addons-yml.mjs",
    "pack": "bare-pack --preset ios --linked --base . --out ../AgentOfficeRemote/app.bundle worklet.js",
    "dev": "node dev-run.mjs",
    "prebuild": "npm run -s link && npm run -s pack"
  },
  "dependencies": {
    "hyperswarm": "4.17.2",
    "hyperdht": "6.34.1",
    "udx-native": "1.21.3",
    "sodium-native": "5.1.0",
    "b4a": "^1.6.7"
  },
  "devDependencies": {
    "bare-link": "^3.2.2",
    "bare-pack": "^2.1.0"
  }
}
