{
  "name": "agent-office",
  "productName": "Agent Office",
  "desktopName": "agent-office.desktop",
  "version": "0.16.0",
  "description": "Claude Code in a pixel office: the real claude CLI in a terminal per project, under one live office where the boss oversees every project",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "sync-core": "node scripts/sync-core.mjs",
    "prestart": "node scripts/sync-core.mjs",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps && node scripts/postinstall.mjs",
    "predist": "node scripts/sync-core.mjs",
    "dist": "electron-builder --mac && rm -rf release/mac release/mac-arm64 release/builder-debug.yml",
    "predist:linux": "node scripts/sync-core.mjs",
    "dist:linux": "electron-builder --linux --config scripts/linux-builder-config.cjs --publish never && rm -rf release/linux-unpacked release/builder-debug.yml",
    "predist:win": "node scripts/sync-core.mjs",
    "dist:win": "electron-builder --win --config scripts/win-builder-config.cjs --publish never && node -e \"for (const p of ['release/win-unpacked', 'release/builder-debug.yml']) require('fs').rmSync(p, { recursive: true, force: true })\"",
    "icon": "node scripts/make-icon.mjs",
    "predist:release": "node scripts/sync-core.mjs",
    "dist:release": "APPLE_KEYCHAIN_PROFILE=${APPLE_KEYCHAIN_PROFILE:-agent-office} electron-builder --mac -c.mac.identity=\"${CSC_NAME:-Savas Isisever (GLTH2M74NT)}\" && rm -rf release/mac release/mac-arm64 release/mac-universal release/builder-debug.yml"
  },
  "author": "Savas Isisever",
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "hyperswarm": "4.17.2"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.isisever.agentoffice",
    "productName": "Agent Office",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "locales/*.json",
      "package.json",
      "!**/*.map",
      "!node_modules/node-pty/{src,scripts,deps,third_party,typings}/**",
      "!node_modules/node-pty/prebuilds/win32-*/**",
      "!node_modules/node-pty/build/Release/obj.target/**",
      "!node_modules/node-pty/.agent-office-swallow.json",
      "!node_modules/node-addon-api/**",
      "!node_modules/{udx-native,sodium-native}/prebuilds/{android,ios,linux,win32}-*/**"
    ],
    "asarUnpack": [
      "src/cmd-mod/**",
      "node_modules/node-pty/**",
      "node_modules/sodium-native/**",
      "node_modules/udx-native/**"
    ],
    "npmRebuild": false,
    "beforePack": "./scripts/before-pack.cjs",
    "fileAssociations": [
      {
        "ext": "agentoffice",
        "name": "Agent Office session",
        "description": "Agent Office session",
        "mimeType": "application/x-agentoffice-session",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.icns",
      "identity": "-",
      "artifactName": "AgentOffice-${version}-${arch}.${ext}",
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "Agent Office"
    },
    "linux": {
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "agent-office",
      "synopsis": "Claude Code in a pixel office",
      "maintainer": "Savas Isisever <isisever@users.noreply.github.com>",
      "artifactName": "AgentOffice-${version}-${arch}.${ext}",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "AgentOffice-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Agent Office"
    },
    "deb": {
      "packageCategory": "devel",
      "recommends": [
        "libappindicator3-1",
        "wl-clipboard | xclip"
      ]
    },
    "extraResources": [
      {
        "from": "../plugin",
        "to": "plugin",
        "filter": [
          ".claude-plugin/plugin.json",
          "hooks/**",
          "types/**",
          "tsconfig.json",
          "LICENSE"
        ]
      },
      {
        "from": "../themes",
        "to": "themes",
        "filter": [
          "*.json"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "isisever",
        "repo": "agent-office"
      }
    ]
  },
  "repository": "https://github.com/isisever/agent-office",
  "homepage": "https://github.com/isisever/agent-office",
  "overrides": {
    "hyperdht": "6.34.1",
    "udx-native": "1.21.3",
    "sodium-native": "5.1.0",
    "bare-addon-resolve": "1.10.1",
    "bare-fs": "4.8.2",
    "bare-module-resolve": "1.12.5",
    "bare-url": "2.5.4",
    "protomux": "3.12.1"
  }
}
