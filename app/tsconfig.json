{
  // Type check (check only, no output): npx -p typescript tsc -p app
  // For now the main process: main.js, preload.js, src/*.js. The renderer and the office drawing code come later.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "files": ["main.js", "preload.js"],
  "include": ["src/*.js"]
}
